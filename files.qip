# kate - Phase 1R: MPEG2FPGA and its DDR bridge remain outside the active
# Quartus design.  rtl/mpeg2fpga remains in the repository only as a
# frozen reference implementation.
set_global_assignment -name SDC_FILE MediaPlayer.sdc
set_global_assignment -name SYSTEMVERILOG_FILE MediaPlayer.sv
