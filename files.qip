# kate - Phase 1T-s extends the factored orchestration; parser and proven P datapaths
# retain their public interfaces and accepted behavior.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mpeg2_new/mpeg2_h262_picture_bookkeeper.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mpeg2_new/mpeg2_h262_p_diagnostic_controller.sv
