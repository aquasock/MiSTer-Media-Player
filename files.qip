set_global_assignment -name SYSTEMVERILOG_FILE rtl/mpeg2_new/mpeg2_h262_p_two_mb_syntax_probe.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mpeg2_new/mpeg2_h262_p_four_mb_two_row_syntax_probe.sv
# kate - Phase 1T-q serialized first-P Y0,Y1,Y2,Y3,Cb,Cr residual pipeline.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mpeg2_new/mpeg2_h262_p_residual_parser_420.sv
