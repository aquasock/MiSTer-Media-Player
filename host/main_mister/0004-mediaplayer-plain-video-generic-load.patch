+// Rewrite stage B: a plain .mpg/.m2v/.mpeg elementary/Program Stream file no
+// longer needs the ARM helper at all - mpeg2_h262_program_stream_demux in
+// MediaPlayer.sv now does the Program Stream/PES demuxing that the helper
+// used to do in software. Route these through the same generic
+// user_io_file_tx() path any ROM-loading core uses, tagged with this file's
+// own F-slot index (MEDIAPLAYER_LOADER_VIDEO_FILE) rather than the helper's
+// fixed MEDIAPLAYER_STREAM_INDEX channel, so the two paths can never collide.
+// DVD/ISO/VOB and the standalone audio-file player are unaffected for now -
+// they still route through mediaplayer_start() below until later rewrite
+// stages replace or remove them.
+int mediaplayer_is_plain_video_file(const char *path)
+{
+	const char *extension = path ? strrchr(path, '.') : NULL;
+	return extension && (!strcasecmp(extension, ".m2v") ||
+	                     !strcasecmp(extension, ".mpg") ||
+	                     !strcasecmp(extension, ".mpeg"));
+}
+
+// Rewrite stage B follow-up: two bugs found testing on real hardware.
+//
+// First, user_io_file_tx_data() is the plain, ACK-per-word blocking
+// primitive (fpga_spi_write_ack_impl on the FPGA-facing side) - it has no
+// idea about this project's MEDIA_BURST credit protocol at all, so bytes
+// sent through it never satisfy mpeg2_stream_fifo's burst_ready gate and
+// the decoder never receives a byte, producing a black screen even after
+// user_io_file_tx_data() itself returns having "sent" the whole file.
+// user_io_file_tx_data_step() is the correct primitive: it negotiates
+// MEDIA_BURST credit and fast-writes only as many bytes as the FPGA has
+// room for, exactly like the ARM helper's own transfer loop already does
+// (see mediaplayer_poll_inner() below) - and critically, it never blocks:
+// a call with no credit available just returns 0 consumed immediately.
+//
+// Second, calling it in a tight loop (as this function originally did)
+// still starves Main's own top-level poll (user_io_poll/input_poll/
+// HandleUI) for the file's entire transfer, which - because this
+// project's Program Stream demux backpressures the transfer to real-time
+// decode consumption - can be the video's entire runtime. The fix is
+// structural, not another loop: plain_video_poll() below is called once
+// per mediaplayer_poll() tick, exactly like the helper-pipe transfer path
+// it sits beside, so Main's normal loop keeps running between calls.
+//
+// user_io_file_info() also now passes the literal ".M2V" rather than the
+// file's real extension, matching every other call site in this file -
+// the FPGA/OSD side expects that literal regardless of the source file's
+// actual name, exactly as it does for the helper-driven paths below.
+static fileTYPE plain_video_file = {};
+static bool plain_video_active = false;
+static media_burst_state plain_video_burst_state = {};
+
+static void plain_video_finish(const char *reason)
+{
+	FileClose(&plain_video_file);
+	if (download_active)
+	{
+		user_io_set_download(0);
+		download_active = 0;
+	}
+	plain_video_active = false;
+	pending_size = pending_offset = 0;
+	pending_eof = false;
+	printf("MediaPlayer: plain video transfer %s\n", reason);
+}
+
+static void plain_video_poll()
+{
+	if (pending_size - pending_offset < 2 && !pending_eof)
+	{
+		const uint32_t remaining = pending_size - pending_offset;
+		if (remaining) pending_buffer[0] = pending_buffer[pending_offset];
+		pending_size = remaining; pending_offset = 0;
+
+		const int count = FileReadAdv(&plain_video_file, pending_buffer + remaining,
+		                              sizeof(pending_buffer) - remaining);
+		if (count > 0) pending_size += (uint32_t)count;
+		else pending_eof = true;
+	}
+
+	if (pending_eof && pending_size == pending_offset)
+	{
+		plain_video_finish("complete");
+		return;
+	}
+
+	uint32_t available = pending_size - pending_offset;
+	if (!pending_eof) available &= ~1u;
+	if (!available) return;
+
+	media_burst_stats burst = {};
+	uint32_t consumed = 0;
+	const int valid = user_io_file_tx_data_step(pending_buffer + pending_offset,
+	    available, &plain_video_burst_state, &burst, &consumed, NULL);
+	if (!valid || consumed > available)
+	{
+		plain_video_finish("transport-fault");
+		return;
+	}
+	if (!consumed) return; // No credit yet: leave the bytes for next poll.
+	pending_offset += consumed;
+}
+
+int mediaplayer_start_plain_video_file(const char *path, unsigned char index)
+{
+	if (!FileOpen(&plain_video_file, path)) return 0;
+
+	printf("MediaPlayer: starting plain video file %s with %llu bytes for index %d\n",
+	       path, (unsigned long long)plain_video_file.size, index);
+
+	user_io_set_index(index);
+	user_io_file_info(".M2V");
+	user_io_set_download(1, 0);
+	download_active = 1;
+
+	pending_size = pending_offset = 0;
+	pending_eof = false;
+	plain_video_burst_state = {};
+	plain_video_active = true;
+	return 1;
+}
