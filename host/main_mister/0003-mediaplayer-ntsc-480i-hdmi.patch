 static void hdmi_config_set_mode(vmode_custom_t *vm)
 {
 	PROFILE_FUNCTION();
 
-	const uint8_t vic_mode = (uint8_t)vm->param.vic;
+	const bool ntsc_480i = mediaplayer_ntsc_480i();
+	const bool ntsc_widescreen = mediaplayer_ntsc_widescreen();
+	const uint8_t ntsc_aspect = ntsc_480i ? (ntsc_widescreen ? 1 : 0) : 0xff;
+	const uint8_t vic_mode = ntsc_480i ? (ntsc_widescreen ? 7 : 6) : (uint8_t)vm->param.vic;
 	uint8_t pr_flags;
 
-	if (cfg.direct_video && is_menu()) pr_flags = 0; // automatic pixel repetition
+	if (ntsc_480i) pr_flags = 0b11000010; // manual x1 PLL; source already supplies each pixel twice
+	else if (cfg.direct_video && is_menu()) pr_flags = 0; // automatic pixel repetition
 	else if (vm->param.pr != 0) pr_flags = 0b01001000; // manual pixel repetition with 2x clock
 	else pr_flags = 0b01000000; // manual pixel repetition
 
-	uint8_t sync_invert = 0;
-	if (vm->param.hpol == 0) sync_invert |= 1 << 5;
-	if (vm->param.vpol == 0) sync_invert |= 1 << 6;
+	uint8_t sync_invert = ntsc_480i ? 0b01100000 : 0;
+	if (!ntsc_480i && vm->param.hpol == 0) sync_invert |= 1 << 5;
+	if (!ntsc_480i && vm->param.vpol == 0) sync_invert |= 1 << 6;
 
-	if (last_sync_invert == sync_invert && last_pr_flags == pr_flags && last_vic_mode == vic_mode) return;
+	if (last_sync_invert == sync_invert && last_pr_flags == pr_flags && last_vic_mode == vic_mode && last_ntsc_aspect == ntsc_aspect) return;
 
 	// address, value
 	uint8_t init_data[] = {
-		0x17, (uint8_t)(0b00000010 | sync_invert),		// Aspect ratio 16:9 [1]=1, 4:3 [1]=0
+		0x17, (uint8_t)((ntsc_480i ? (ntsc_widescreen ? 0b10 : 0) : 0b10) | sync_invert),	// Aspect ratio 16:9 [1]=1, 4:3 [1]=0
 		0x3B, pr_flags,
 		0x3C, vic_mode,			// VIC
 	};
@@ -1719,11 +1747,27 @@ static void hdmi_config_set_mode(vmode_custom_t *vm)
 			int res = i2c_smbus_write_byte_data(hdmi_main_fd, init_data[i], init_data[i + 1]);
 			if (res < 0) printf("i2c: write error (%02X %02X): %d\n", init_data[i], init_data[i + 1], res);
 		}
+
+		if (ntsc_480i)
+		{
+			const uint8_t avi_data[] = {
+				0x55, 0b00010001,	// RGB, active format valid, TV scan behavior
+				0x56, (uint8_t)(0b01001000 | (ntsc_widescreen ? 0b00100000 : 0b00010000)),	// BT.601, 16:9/4:3
+				0x57, 0b00000100,	// Limited-range RGB
+			};
+
+			for (uint i = 0; i < sizeof(avi_data); i += 2)
+			{
+				int res = i2c_smbus_write_byte_data(hdmi_main_fd, avi_data[i], avi_data[i + 1]);
+				if (res < 0) printf("i2c: write error (%02X %02X): %d\n", avi_data[i], avi_data[i + 1], res);
+			}
+		}
 	}
 
 	last_pr_flags = pr_flags;
 	last_sync_invert = sync_invert;
 	last_vic_mode = vic_mode;
+	last_ntsc_aspect = ntsc_aspect;
 }
 
