diff --git a/support/mediaplayer/overlay_trace.h b/support/mediaplayer/overlay_trace.h
new file mode 100644
--- /dev/null
+++ b/support/mediaplayer/overlay_trace.h
@@ -0,0 +1,280 @@
+#ifndef MEDIAPLAYER_OVERLAY_TRACE_H
+#define MEDIAPLAYER_OVERLAY_TRACE_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+enum media_overlay_trace_event_kind
+{
+	MEDIA_OVERLAY_TRACE_INVALID_LENGTH,
+	MEDIA_OVERLAY_TRACE_CONFIG,
+	MEDIA_OVERLAY_TRACE_COMMIT,
+	MEDIA_OVERLAY_TRACE_STYLE,
+	MEDIA_OVERLAY_TRACE_CLEAR,
+	MEDIA_OVERLAY_TRACE_UNKNOWN
+};
+
+struct media_overlay_trace_event
+{
+	media_overlay_trace_event_kind kind;
+	uint64_t offset;
+	uint32_t sequence;
+	uint32_t data_records;
+	uint32_t data_bytes;
+	uint32_t fnv1a;
+	uint32_t non_55_bytes;
+	uint32_t frame_order_errors;
+	uint16_t length;
+	uint8_t command;
+	uint8_t payload[41];
+	uint8_t payload_size;
+	bool probe_payload;
+	bool probe_complete;
+};
+
+typedef void (*media_overlay_trace_callback)(
+	void *opaque, const media_overlay_trace_event *event);
+
+struct media_overlay_trace
+{
+	enum phase_type { SEARCH, LENGTH_HIGH, LENGTH_LOW, PAYLOAD } phase;
+	uint32_t window;
+	uint64_t offset;
+	uint16_t length;
+	uint16_t remaining;
+	uint8_t command;
+	uint8_t payload[41];
+	uint8_t payload_size;
+	uint8_t last_style[41];
+	bool last_style_valid;
+	bool frame_active;
+	bool frame_probe_config;
+	uint32_t frame_sequence;
+	uint32_t frame_data_records;
+	uint32_t frame_data_bytes;
+	uint32_t frame_fnv1a;
+	uint32_t frame_non_55_bytes;
+	uint32_t frame_order_errors;
+	uint32_t markers;
+	uint32_t configs;
+	uint32_t data_records;
+	uint32_t data_bytes;
+	uint32_t commits;
+	uint32_t styles;
+	uint32_t style_changes;
+	uint32_t clears;
+	uint32_t invalid_lengths;
+	uint32_t unknown_commands;
+	uint32_t order_errors;
+	media_overlay_trace_callback callback;
+	void *callback_opaque;
+};
+
+static inline bool media_overlay_trace_probe_payload(const uint8_t *payload,
+	                                                   size_t size)
+{
+	if (size != 41 || payload[0] != 3)
+		return false;
+	for (size_t index = 1; index <= 32; ++index)
+	{
+		const uint8_t expected = index == 21 || index == 23 || index == 24 ?
+		                         0xff : 0x00;
+		if (payload[index] != expected)
+			return false;
+	}
+	const unsigned x1 = ((unsigned)payload[33] << 8) | payload[34];
+	const unsigned y1 = ((unsigned)payload[35] << 8) | payload[36];
+	const unsigned x2 = ((unsigned)payload[37] << 8) | payload[38];
+	const unsigned y2 = ((unsigned)payload[39] << 8) | payload[40];
+	return x1 <= x2 && y1 <= y2 && x2 < 720 && y2 < 480;
+}
+
+static inline void media_overlay_trace_reset(media_overlay_trace *trace,
+	                                          media_overlay_trace_callback callback,
+	                                          void *opaque)
+{
+	memset(trace, 0, sizeof(*trace));
+	trace->phase = media_overlay_trace::SEARCH;
+	trace->callback = callback;
+	trace->callback_opaque = opaque;
+}
+
+static inline void media_overlay_trace_emit(media_overlay_trace *trace,
+	                                         media_overlay_trace_event_kind kind,
+	                                         bool probe_complete)
+{
+	if (!trace->callback)
+		return;
+	media_overlay_trace_event event = {};
+	event.kind = kind;
+	event.offset = trace->offset;
+	event.sequence = trace->frame_sequence;
+	event.data_records = trace->frame_data_records;
+	event.data_bytes = trace->frame_data_bytes;
+	event.fnv1a = trace->frame_fnv1a;
+	event.non_55_bytes = trace->frame_non_55_bytes;
+	event.frame_order_errors = trace->frame_order_errors;
+	event.length = trace->length;
+	event.command = trace->command;
+	event.payload_size = trace->payload_size;
+	memcpy(event.payload, trace->payload, trace->payload_size);
+	event.probe_payload = media_overlay_trace_probe_payload(
+		trace->payload, trace->payload_size);
+	event.probe_complete = probe_complete;
+	trace->callback(trace->callback_opaque, &event);
+}
+
+static inline void media_overlay_trace_order_error(media_overlay_trace *trace)
+{
+	++trace->order_errors;
+	++trace->frame_order_errors;
+}
+
+static inline void media_overlay_trace_record_complete(media_overlay_trace *trace)
+{
+	bool probe_complete = false;
+	switch (trace->command)
+	{
+	case 0x00:
+		++trace->clears;
+		if (trace->length != 1)
+			media_overlay_trace_order_error(trace);
+		media_overlay_trace_emit(trace, MEDIA_OVERLAY_TRACE_CLEAR, false);
+		break;
+	case 0x01:
+		{
+		const bool interrupted = trace->frame_active;
+		if (interrupted)
+			++trace->order_errors;
+		trace->frame_active = true;
+		++trace->frame_sequence;
+		trace->frame_data_records = 0;
+		trace->frame_data_bytes = 0;
+		trace->frame_fnv1a = 2166136261u;
+		trace->frame_non_55_bytes = 0;
+		trace->frame_order_errors = (interrupted ? 1u : 0u) +
+		                            (trace->length == 42 ? 0u : 1u);
+		if (trace->length != 42)
+			++trace->order_errors;
+		trace->frame_probe_config = media_overlay_trace_probe_payload(
+			trace->payload, trace->payload_size);
+		++trace->configs;
+		media_overlay_trace_emit(trace, MEDIA_OVERLAY_TRACE_CONFIG, false);
+		}
+		break;
+	case 0x02:
+		++trace->data_records;
+		trace->data_bytes += trace->length > 0 ? trace->length - 1 : 0;
+		if (!trace->frame_active || trace->length < 2)
+			media_overlay_trace_order_error(trace);
+		++trace->frame_data_records;
+		break;
+	case 0x03:
+		++trace->commits;
+		if (!trace->frame_active || trace->length != 1)
+			media_overlay_trace_order_error(trace);
+		probe_complete = trace->frame_active && trace->frame_probe_config &&
+			trace->frame_data_records == 22 &&
+			trace->frame_data_bytes == 86400 &&
+			trace->frame_fnv1a == 0xf8555d45u &&
+			trace->frame_non_55_bytes == 0 &&
+			trace->frame_order_errors == 0;
+		media_overlay_trace_emit(trace, MEDIA_OVERLAY_TRACE_COMMIT,
+		                         probe_complete);
+		trace->frame_active = false;
+		break;
+	case 0x04:
+		++trace->styles;
+		if (trace->length != 42)
+			media_overlay_trace_order_error(trace);
+		if (!trace->last_style_valid || trace->payload_size != 41 ||
+		    memcmp(trace->last_style, trace->payload, 41))
+		{
+			++trace->style_changes;
+			media_overlay_trace_emit(trace, MEDIA_OVERLAY_TRACE_STYLE, false);
+			if (trace->payload_size == 41)
+			{
+				memcpy(trace->last_style, trace->payload, 41);
+				trace->last_style_valid = true;
+			}
+		}
+		break;
+	default:
+		++trace->unknown_commands;
+		media_overlay_trace_order_error(trace);
+		media_overlay_trace_emit(trace, MEDIA_OVERLAY_TRACE_UNKNOWN, false);
+		break;
+	}
+}
+
+static inline void media_overlay_trace_feed(media_overlay_trace *trace,
+	                                         const uint8_t *data, size_t size)
+{
+	for (size_t index = 0; index < size; ++index)
+	{
+		const uint8_t byte = data[index];
+		++trace->offset;
+		switch (trace->phase)
+		{
+		case media_overlay_trace::SEARCH:
+			trace->window = (trace->window << 8) | byte;
+			if (trace->window == 0x000001b9u)
+			{
+				++trace->markers;
+				trace->window = 0;
+				trace->phase = media_overlay_trace::LENGTH_HIGH;
+			}
+			break;
+		case media_overlay_trace::LENGTH_HIGH:
+			trace->length = (uint16_t)byte << 8;
+			trace->phase = media_overlay_trace::LENGTH_LOW;
+			break;
+		case media_overlay_trace::LENGTH_LOW:
+			trace->length |= byte;
+			if (!trace->length || trace->length > 4097)
+			{
+				++trace->invalid_lengths;
+				trace->command = 0xff;
+				trace->payload_size = 0;
+				media_overlay_trace_emit(trace,
+				                         MEDIA_OVERLAY_TRACE_INVALID_LENGTH,
+				                         false);
+				trace->phase = media_overlay_trace::SEARCH;
+				trace->window = 0;
+			}
+			else
+			{
+				trace->remaining = trace->length;
+				trace->payload_size = 0;
+				trace->phase = media_overlay_trace::PAYLOAD;
+			}
+			break;
+		case media_overlay_trace::PAYLOAD:
+			if (trace->remaining == trace->length)
+				trace->command = byte;
+			else
+			{
+				if (trace->payload_size < sizeof(trace->payload))
+					trace->payload[trace->payload_size++] = byte;
+				if (trace->command == 0x02)
+				{
+					trace->frame_fnv1a ^= byte;
+					trace->frame_fnv1a *= 16777619u;
+					++trace->frame_data_bytes;
+					if (byte != 0x55)
+						++trace->frame_non_55_bytes;
+				}
+			}
+			if (!--trace->remaining)
+			{
+				media_overlay_trace_record_complete(trace);
+				trace->phase = media_overlay_trace::SEARCH;
+				trace->window = 0;
+			}
+			break;
+		}
+	}
+}
+
+#endif
