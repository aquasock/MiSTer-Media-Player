+		                 "data_records=%u data_bytes=%u fnv1a=%08x non55=%u "
+		                 "order_errors=%u probe_complete=%u\n",
+		                 event->sequence, (unsigned long long)event->offset,
+		                 (unsigned)event->length, event->data_records,
+		                 event->data_bytes, event->fnv1a, event->non_55_bytes,
+		                 event->frame_order_errors, event->probe_complete);
+		break;
+	case MEDIA_OVERLAY_TRACE_CLEAR:
