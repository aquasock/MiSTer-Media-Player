+// MediaPlayer-only acknowledged bulk path; ordinary file transfers are unchanged.
+void user_io_file_tx_data_ack(const uint8_t *addr, uint32_t len,
+                            fpga_spi_profile *profile)
+{
+	EnableFpga();
+	spi8(FIO_FILE_TX_DAT);
+	fpga_spi_write_ack(addr, len, fio_size, profile);
+	DisableFpga();
+}
+
+struct media_burst_status
+{
+	bool supported;
+	uint16_t credit, digest, flags;
+	uint32_t words;
+};
+
+static media_burst_status media_burst_query(media_burst_stats *stats)
+{
+	EnableFpga();
+	const uint16_t magic = spi_w(0x57);
+	const uint16_t version = spi_w(0);
+	media_burst_status status;
+	status.supported = magic == 0x4D50 && version == 0xB001;
+	status.credit = spi_w(0);
+	const uint32_t low = spi_w(0);
+	status.words = low | ((uint32_t)spi_w(0) << 16);
+	status.digest = spi_w(0);
+	status.flags = spi_w(0);
+	DisableFpga();
+	++stats->queries;
+	return status;
+}
+
+static void media_burst_account(media_burst_state *state, const uint8_t *addr, uint32_t len)
+{
+	state->words += (len + 1) / 2;
+	while (len)
+	{
+		uint16_t word = *addr++; --len;
+		if (len) { word |= (uint16_t)*addr++ << 8; --len; }
+		state->digest = (uint16_t)((state->digest << 1) | (state->digest >> 15)) ^ word;
+	}
+}
+
+// A capability/status command brackets every fast batch. Its accepted count and
+// checksum also drain/verify the prior FIO write pipeline before further data.
+int user_io_file_tx_data_burst(const uint8_t *addr, uint32_t len,
+                              media_burst_state *state, media_burst_stats *stats,
+                              fpga_spi_profile *profile)
+{
+	if (!len) return 1;
+	if (!fio_size) state->mode = 1;
+	if (state->mode == 1)
+	{
+		user_io_file_tx_data_ack(addr, len, profile);
+		stats->slow_bytes += len;
+		return 1;
+	}
+	media_burst_status status = media_burst_query(stats);
+	if (!state->mode)
+	{
+		if (!status.supported)
+		{
+			state->mode = 1;
+			user_io_file_tx_data_ack(addr, len, profile);
+			stats->slow_bytes += len;
+			return 1;
+		}
+		state->mode = 2;
+		state->words = status.words;
+		state->digest = status.digest;
+	}
+	for (;;)
+	{
+		stats->expected_words = state->words;
+		stats->observed_words = status.words;
+		stats->expected_digest = state->digest;
+		stats->observed_digest = status.digest;
+		stats->credit = status.credit;
+		stats->flags = status.flags;
+		if (!status.supported || status.credit > 4096) { stats->error = 1; return 0; }
+		if (status.flags != 1) { stats->error = 2; return 0; }
+		if (status.words != state->words || status.digest != state->digest) { stats->error = 3; return 0; }
+		if (!len) return 1;
+		uint32_t count;
+		if (((uintptr_t)addr & 1) || len < 2 || !status.credit)
+		{
+			// Unaligned buffers keep the byte-safe path. Zero credits make one
+			// acknowledged word of progress rather than spinning on status.
+			count = ((uintptr_t)addr & 1) ? len : (len < 2 ? len : 2);
+			user_io_file_tx_data_ack(addr, count, profile);
+			stats->slow_bytes += count;
+		}
+		else
+		{
+			count = len / 2;
+			if (count > status.credit) count = status.credit;
+			EnableFpga();
+			spi8(FIO_FILE_TX_DAT);
+			fpga_spi_fast_block_write((const uint16_t *)addr, count);
+			DisableFpga();
+			count *= 2;
+			stats->fast_bytes += count;
+			++stats->batches;
+		}
+		media_burst_account(state, addr, count);
+		addr += count; len -= count;
+		status = media_burst_query(stats);
+	}
+}
+
+// One verified-credit transaction, at most 2048 source bytes. Success may
+// consume zero bytes: the caller must retain the buffer and yield, not spin.
+// Legacy cores retain acknowledged semantics (and their existing wait behavior).
+int user_io_file_tx_data_step(const uint8_t *addr, uint32_t len,
+                             media_burst_state *state, media_burst_stats *stats,
+                             uint32_t *consumed, fpga_spi_profile *profile)
+{
+	*consumed = 0;
+	if (!len) return 1;
+	if (!fio_size) state->mode = 1;
+	media_burst_status status = {};
+	if (state->mode != 1)
+	{
+		status = media_burst_query(stats);
+		if (!state->mode)
+		{
+			state->mode = status.supported ? 2 : 1;
+			state->words = status.words;
+			state->digest = status.digest;
+		}
+	}
+	uint32_t count = len < 2048 ? len : 2048;
+	if (state->mode == 1)
+	{
+		user_io_file_tx_data_ack(addr, count, profile);
+		stats->slow_bytes += count;
+		*consumed = count;
+		return 1;
+	}
+	// Validate before sending, including when a previous call yielded.
+	stats->expected_words = state->words;
+	stats->observed_words = status.words;
+	stats->expected_digest = state->digest;
+	stats->observed_digest = status.digest;
+	stats->credit = status.credit;
+	stats->flags = status.flags;
+	if (!status.supported || status.credit > 4096) { stats->error = 1; return 0; }
+	if (status.flags != 1) { stats->error = 2; return 0; }
+	if (status.words != state->words || status.digest != state->digest) { stats->error = 3; return 0; }
+	if (!status.credit) return 1;
+	if (count > status.credit * 2u) count = status.credit * 2u;
+	// Pack locally, so unaligned input never falls back to a blocking ACK.
+	// The loader offers an odd length only after EOF: padding occurs once.
+	uint16_t words[1024];
+	for (uint32_t i = 0; i < count; i += 2)
+		words[i / 2] = addr[i] | (i + 1 < count ? uint16_t(addr[i + 1]) << 8 : 0);
+	EnableFpga();
+	spi8(FIO_FILE_TX_DAT);
+	fpga_spi_fast_block_write(words, (count + 1) / 2);
+	DisableFpga();
+	stats->fast_bytes += count;
+	++stats->batches;
+	media_burst_account(state, addr, count);
+	status = media_burst_query(stats);
+	stats->expected_words = state->words;
+	stats->observed_words = status.words;
+	stats->expected_digest = state->digest;
+	stats->observed_digest = status.digest;
+	stats->credit = status.credit;
+	stats->flags = status.flags;
+	if (!status.supported || status.credit > 4096) { stats->error = 1; return 0; }
+	if (status.flags != 1) { stats->error = 2; return 0; }
+	if (status.words != state->words || status.digest != state->digest) { stats->error = 3; return 0; }
+	*consumed = count;
+	return 1;
+}
