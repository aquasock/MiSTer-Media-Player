diff --git a/fpga_io.cpp b/fpga_io.cpp
index b64cfe5..2912a55 100644
--- a/fpga_io.cpp
+++ b/fpga_io.cpp
@@ -720,6 +720,82 @@ uint16_t fpga_spi(uint16_t word)
 	return (uint16_t)gpi;
 }
 
+// Prepare little-endian words without alignment assumptions or an odd-tail read.
+static inline uint32_t fpga_spi_next_word(const uint8_t *&buf, uint32_t &len, int wide)
+{
+	uint32_t word = *buf++;
+	--len;
+	if (wide && len) { word |= (uint32_t)*buf++ << 8; --len; }
+	return word;
+}
+
+// MediaPlayer bulk writes retain BOTH ACK phases. Once ACK-high confirms the
+// current word, the falling edge can preload the next payload. ACK-low then
+// establishes the low phase before that payload's rising edge. This removes
+// the redundant low-data write between words, not the backpressure handshake.
+template<bool Profile>
+static void fpga_spi_write_ack_impl(const uint8_t *buf, uint32_t len, int wide,
+                                    fpga_spi_profile *profile)
+{
+	if (!len) return;
+	const uint32_t base = fpga_gpo_read() & ~(0xFFFF | SSPI_STROBE);
+	uint32_t gpo = base | fpga_spi_next_word(buf, len, wide);
+	fpga_gpo_write(gpo);
+	for (;;)
+	{
+		fpga_gpo_write(gpo | SSPI_STROBE);
+		uint64_t high_reads = 0, low_reads = 0;
+		int gpi;
+		do
+		{
+			gpi = fpga_gpi_read();
+			if (Profile) ++high_reads;
+			if (gpi < 0)
+			{
+				printf("GPI[31]==1. FPGA is uninitialized?\n");
+				if (Profile) ++profile->uninitialized;
+				fpga_wait_to_reset();
+				return;
+			}
+		} while (!(gpi & SSPI_ACK));
+
+		const bool more = len != 0;
+		if (more) gpo = base | fpga_spi_next_word(buf, len, wide);
+		fpga_gpo_write(gpo);
+		do
+		{
+			gpi = fpga_gpi_read();
+			if (Profile) ++low_reads;
+			if (gpi < 0)
+			{
+				printf("GPI[31]==1. FPGA is uninitialized?\n");
+				if (Profile) ++profile->uninitialized;
+				fpga_wait_to_reset();
+				return;
+			}
+		} while (gpi & SSPI_ACK);
+		if (Profile)
+		{
+			++profile->words;
+			profile->high_reads += high_reads;
+			profile->low_reads += low_reads;
+			profile->high_wait_words += high_reads > 1;
+			profile->low_wait_words += low_reads > 1;
+			if (high_reads > profile->high_max_reads) profile->high_max_reads = high_reads;
+			if (low_reads > profile->low_max_reads) profile->low_max_reads = low_reads;
+		}
+		if (!more) return;
+	}
+}
+
+void fpga_spi_write_ack(const uint8_t *buf, uint32_t len, int wide,
+                        fpga_spi_profile *profile)
+{
+	// Select once per chunk; the unsampled specialization has no counter updates.
+	if (profile) fpga_spi_write_ack_impl<true>(buf, len, wide, profile);
+	else fpga_spi_write_ack_impl<false>(buf, len, wide, NULL);
+}
+
 uint16_t fpga_spi_fast(uint16_t word)
 {
 	uint32_t gpo = (fpga_gpo_read() & ~(0xFFFF | SSPI_STROBE)) | word;
