+	MEDIA_CONTROL_MENU_ENTER = 0x82,
+	MEDIA_CONTROL_MENU_LEAVE = 0x83,
+	MEDIA_CONTROL_MENU_CONTINUE = 0x84,
+	MEDIA_CONTROL_ERROR = 0xff
+};
+
+struct media_transfer_profile
+{
+	uint64_t polls, poll_us, poll_max_us;
+	uint64_t data_polls, data_poll_us, poll_tx_start;
+	uint64_t last_poll_start, poll_start, poll_interval;
+	uint64_t intervals, interval_us, interval_max_us;
+	uint64_t read_calls, read_us;
+	uint64_t tx_calls, tx_us, tx_max_us, ack_chunks;
+	uint64_t fast_bytes, slow_bytes, burst_calls, status_queries;
+	bool poll_active;
+};
+static media_transfer_profile transfer_profile = {};
+static media_burst_state burst_state = {};
+static uint8_t pending_buffer[16384];
+static uint32_t pending_size = 0, pending_offset = 0;
+static bool pending_eof = false;
+static unsigned transfer_events = 0;
+static const unsigned media_poll_budget_us = 2000;
+static const unsigned media_poll_step_limit = 8;
+
+
+static uint64_t monotonic_us()
+{
+	struct timespec now;
+	if (clock_gettime(CLOCK_MONOTONIC, &now)) return 0;
+	return (uint64_t)now.tv_sec * 1000000ull + (uint64_t)(now.tv_nsec / 1000);
+}
+
+static void diagnostic_write(const char *format, ...)
+{
+	char message[1024];
+	va_list arguments;
+	int prefix;
+	int length;
+
+	if (diagnostic_fd < 0) return;
+	prefix = snprintf(message, sizeof(message), "t=%llu ",
+	                  (unsigned long long)(monotonic_us() - session_start_us));
+	if (prefix < 0) return;
+	if ((size_t)prefix >= sizeof(message)) prefix = sizeof(message) - 1;
+	va_start(arguments, format);
+	length = vsnprintf(message + prefix, sizeof(message) - (size_t)prefix,
+	                   format, arguments);
+	va_end(arguments);
+	if (length < 0) return;
+	if ((size_t)length >= sizeof(message) - (size_t)prefix)
+		length = (int)(sizeof(message) - (size_t)prefix) - 1;
+	(void)write(diagnostic_fd, message, (size_t)prefix + (size_t)length);
+}
+
+static void profile_poll_finish()
+{
+	media_transfer_profile &p = transfer_profile;
+	if (!p.poll_active) return;
+	const uint64_t elapsed = monotonic_us() - p.poll_start;
+	p.poll_active = false;
+	const uint64_t chunks = p.tx_calls - p.poll_tx_start;
+	++p.polls;
+	if (chunks) { ++p.data_polls; p.data_poll_us += elapsed; }
+	p.poll_us += elapsed;
+	if (elapsed > p.poll_max_us) p.poll_max_us = elapsed;
+	if (p.polls <= 4 || !(p.polls % 64) || helper_fd < 0)
+		diagnostic_write("profile_poll polls=%llu elapsed_us=%llu interval_us=%llu chunks=%llu\n",
+		                 (unsigned long long)p.polls, (unsigned long long)elapsed,
+		                 (unsigned long long)p.poll_interval, (unsigned long long)chunks);
+}
+
+static void profile_summary()
+{
+	const media_transfer_profile &p = transfer_profile;
+	diagnostic_write("profile_summary polls=%llu poll_us=%llu poll_max_us=%llu "
+	                 "data_polls=%llu data_poll_us=%llu "
+	                 "intervals=%llu interval_us=%llu interval_max_us=%llu "
+	                 "read_calls=%llu read_us=%llu tx_calls=%llu tx_us=%llu "
+	                 "tx_max_us=%llu ack_chunks=%llu fast_bytes=%llu slow_bytes=%llu "
+	                 "burst_calls=%llu status_queries=%llu transport_mode=%u\n",
+	                 (unsigned long long)p.polls, (unsigned long long)p.poll_us,
+	                 (unsigned long long)p.poll_max_us, (unsigned long long)p.data_polls,
+	                 (unsigned long long)p.data_poll_us, (unsigned long long)p.intervals,
+	                 (unsigned long long)p.interval_us, (unsigned long long)p.interval_max_us,
+	                 (unsigned long long)p.read_calls, (unsigned long long)p.read_us,
+	                 (unsigned long long)p.tx_calls, (unsigned long long)p.tx_us,
+	                 (unsigned long long)p.tx_max_us, (unsigned long long)p.ack_chunks,
+	                 (unsigned long long)p.fast_bytes, (unsigned long long)p.slow_bytes,
+	                 (unsigned long long)p.burst_calls, (unsigned long long)p.status_queries,
+	                 burst_state.mode);
+}
+
+static void diagnostic_close()
+{
+	if (diagnostic_fd >= 0)
+	{
+		profile_poll_finish();
+		profile_summary();
+		(void)fsync(diagnostic_fd);
+		close(diagnostic_fd);
+		diagnostic_fd = -1;
+	}
+}
+
+static void diagnostic_open(const char *source_spec, unsigned char index,
+                            bool enabled)
+{
+	diagnostic_close();
+	burst_state = {};
+	pending_size = pending_offset = 0;
+	pending_eof = false;
+	transfer_events = 0;
+	submitted_bytes = 0;
+	read_events = 0;
+	would_block_events = 0;
+	session_start_us = monotonic_us();
+	download_assert_us = 0;
+	first_byte_seen = 0;
+	transfer_profile = {};
+	if (!enabled)
+	{
+		(void)unlink(diagnostic_path);
+		return;
+	}
+	diagnostic_fd = open(diagnostic_path,
+	                     O_WRONLY | O_CREAT | O_TRUNC | O_APPEND | O_CLOEXEC,
+	                     0644);
+	diagnostic_write("start source=%s index=%u core=%s alternate=%s\n",
+	                 source_spec, (unsigned)index,
+	                 user_io_get_core_name(), user_io_get_core_name(1));
+	diagnostic_write("profile_version=2 transport=credit_step_v1 ack_sample_every=64 "
+	                 "first_byte_means=first_verified_step "
+	                 "interval_means=media_poll_entry_to_entry poll_budget_us=2000 step_bytes=2048 step_limit=8\n");
+}
+
+static int has_core_prefix(const char *name)
+{
+	return name && !strncasecmp(name, "MediaPlayer", 11);
+}
+
+int mediaplayer_is_core()
+{
+	return has_core_prefix(user_io_get_core_name()) ||
+	       has_core_prefix(user_io_get_core_name(1));
+}
+
+int mediaplayer_handles_file(const char *path)
+{
+	const char *extension = path ? strrchr(path, '.') : NULL;
+	return extension && (!strcasecmp(extension, ".m2v") ||
+	                     !strcasecmp(extension, ".mpg") ||
+	                     !strcasecmp(extension, ".mpeg") ||
+	                     !strcasecmp(extension, ".vob") || !strcasecmp(extension, ".iso") ||
+	                     !strcasecmp(extension, ".dvd") ||
+	                     !strcasecmp(extension, ".mp3") ||
+	                     !strcasecmp(extension, ".wav") ||
+	                     !strcasecmp(extension, ".flac") ||
+	                     !strcasecmp(extension, ".ogg"));
+}
+
+static void finish_download(const char *reason)
+{
+	pending_size = pending_offset = 0;
+	pending_eof = false;
+	diagnostic_write("finish reason=%s fd=%d download=%d submitted=%llu reads=%u would_block=%u\n",
+	                 reason, helper_fd, download_active,
+	                 (unsigned long long)submitted_bytes, read_events,
+	                 would_block_events);
+	if (helper_fd >= 0)
+	{
+		close(helper_fd);
+		helper_fd = -1;
+	}
+	if (control_fd >= 0)
+	{
+		close(control_fd);
+		control_fd = -1;
+	}
+	if (download_active)
+	{
+		user_io_set_download(0);
+		download_active = 0;
+		diagnostic_write("download released\n");
+	}
+	playback_paused = false;
+	chapter_barrier = false;
+	chapter_download_rearmed = false;
+	navigation_pending = false;
+	chapter_controls = false;
+	seek_controls = false;
+	menu_controls = false;
+	menu_active = false;
+}
+
+static void stop_with_reason(const char *reason)
+{
+	int status = 0;
+	pid_t result;
+
+	if (helper_fd >= 0 || helper_pid > 0 || download_active)
+		diagnostic_write("stop reason=%s pid=%d\n", reason, (int)helper_pid);
+	finish_download(reason);
+	if (helper_pid > 0)
+	{
+		int killed = kill(-helper_pid, SIGTERM);
+		int saved_errno = errno;
+		result = waitpid(helper_pid, &status, 0);
+		diagnostic_write("stop child kill=%d kill_errno=%d wait=%d status=0x%x wait_errno=%d\n",
+		                 killed, killed < 0 ? saved_errno : 0, (int)result,
+		                 status, result < 0 ? errno : 0);
+		helper_pid = -1;
+	}
+	diagnostic_close();
+}
+
+void mediaplayer_stop()
+{
+	stop_with_reason("external");
+}
+
+int mediaplayer_start(const char *path, unsigned char index)
+{
+	if (!mediaplayer_handles_file(path)) return 0;
+	const char *extension = strrchr(path, '.');
+	std::string source_spec;
+	if (!strcasecmp(extension, ".dvd")) source_spec = "dvdmenu:/dev/sr0";
+	else
+	{
+		source_spec = !strcasecmp(extension, ".iso") ? "isomenu:" : "file:";
+		source_spec += getFullPath(path);
+	}
+	return mediaplayer_start_source(source_spec.c_str(), index);
+}
+
+int mediaplayer_start_source(const char *source_spec, unsigned char index)
+{
+	int pipefd[2];
+	int control_pair[2];
+	pid_t pid;
+	const char *audio_out;
+	bool telemetry_enabled;
+
+	if (!mediaplayer_is_core() || !source_spec || !*source_spec) return 0;
+	/*
+	 * The AC-3 decoder runs in the helper, so only the helper can choose
+	 * between decoded stereo and an IEC 61937 burst. Read the same OSD bit
+	 * the core uses for routing, here in the parent rather than after the
+	 * fork, and fix the mode for this playback.
+	 */
+	audio_out = user_io_status_get("[126]") ? "spdif" : "hdmi";
+	telemetry_enabled = user_io_status_get("[125]");
+	mediaplayer_stop();
+	diagnostic_open(source_spec, index, telemetry_enabled);
+	if (pipe(pipefd) < 0)
+	{
+		diagnostic_write("pipe failed errno=%d message=%s\n", errno, strerror(errno));
+		printf("MediaPlayer: pipe failed: %s\n", strerror(errno));
+		diagnostic_close();
+		return 0;
+	}
+	if (socketpair(AF_UNIX, SOCK_SEQPACKET, 0, control_pair) < 0)
+	{
+		diagnostic_write("control socket failed errno=%d message=%s\n", errno, strerror(errno));
+		printf("MediaPlayer: control socket failed: %s\n", strerror(errno));
+		close(pipefd[0]);
+		close(pipefd[1]);
+		diagnostic_close();
+		return 0;
+	}
+	pid = fork();
+	if (pid < 0)
+	{
+		diagnostic_write("fork failed errno=%d message=%s\n", errno, strerror(errno));
+		printf("MediaPlayer: fork failed: %s\n", strerror(errno));
+		close(pipefd[0]);
+		close(pipefd[1]);
+		close(control_pair[0]);
+		close(control_pair[1]);
+		diagnostic_close();
+		return 0;
+	}
+	if (pid == 0)
+	{
+		char control_fd_text[32];
+
+		(void)setpgid(0, 0);
+		(void)dup2(pipefd[1], STDOUT_FILENO);
+		if (diagnostic_fd >= 0)
+			(void)dup2(diagnostic_fd, STDERR_FILENO);
+		else
+		{
+			int null_fd = open("/dev/null", O_WRONLY | O_CLOEXEC);
+			if (null_fd >= 0)
+			{
+				(void)dup2(null_fd, STDERR_FILENO);
+				if (null_fd != STDERR_FILENO) close(null_fd);
+			}
+			else
+				close(STDERR_FILENO);
+		}
+		close(pipefd[0]);
+		close(pipefd[1]);
+		close(control_pair[0]);
+		snprintf(control_fd_text, sizeof(control_fd_text), "%d", control_pair[1]);
+		if (diagnostic_fd >= 0 && diagnostic_fd != STDERR_FILENO)
+			close(diagnostic_fd);
+		execl(helper_path, "MediaPlayer_Helper", "--protocol", "1",
+		      "--audio-out", audio_out, "--control-fd", control_fd_text,
+		      "--source", source_spec, (char *)NULL);
+		fprintf(stderr, "MediaPlayer: cannot start %s: %s\n", helper_path, strerror(errno));
+		_exit(127);
+	}
+
+	close(pipefd[1]);
+	close(control_pair[1]);
+	(void)setpgid(pid, pid);
+	diagnostic_write("helper forked pid=%d read_fd=%d control_fd=%d\n",
+	                 (int)pid, pipefd[0], control_pair[0]);
+	if (fcntl(pipefd[0], F_SETFL, fcntl(pipefd[0], F_GETFL) | O_NONBLOCK) < 0 ||
+	    fcntl(control_pair[0], F_SETFL,
+	          fcntl(control_pair[0], F_GETFL) | O_NONBLOCK) < 0)
+	{
+		diagnostic_write("nonblocking failed errno=%d message=%s\n", errno, strerror(errno));
+		printf("MediaPlayer: nonblocking pipe failed: %s\n", strerror(errno));
+		close(pipefd[0]);
+		close(control_pair[0]);
+		kill(-pid, SIGTERM);
+		(void)waitpid(pid, NULL, 0);
+		diagnostic_close();
+		return 0;
+	}
+
+	helper_fd = pipefd[0];
+	control_fd = control_pair[0];
+	helper_pid = pid;
+	playback_index = index;
+	playback_paused = false;
+	chapter_barrier = false;
+	chapter_download_rearmed = false;
+	navigation_pending = false;
+	menu_active = false;
+	menu_controls = !strncasecmp(source_spec, "dvdmenu:", 8) ||
+	                !strncasecmp(source_spec, "isomenu:", 8);
+	chapter_controls = menu_controls || !strncasecmp(source_spec, "dvd:", 4) ||
+	                   !strncasecmp(source_spec, "iso:", 4);
+	const char *source_extension = strrchr(source_spec, '.');
+	seek_controls = !strncasecmp(source_spec, "file:", 5) && source_extension &&
+	                (!strcasecmp(source_extension, ".mpg") ||
+	                 !strcasecmp(source_extension, ".mpeg") ||
+	                 !strcasecmp(source_extension, ".mp3") ||
+	                 !strcasecmp(source_extension, ".wav") ||
+	                 !strcasecmp(source_extension, ".flac") ||
+	                 !strcasecmp(source_extension, ".ogg"));
+	user_io_set_index(index);
+	user_io_file_info(".M2V");
+	user_io_set_download(1);
+	download_active = 1;
+	download_assert_us = monotonic_us();
+	diagnostic_write("download asserted index=%u pid=%d\n",
+	                 (unsigned)index, (int)helper_pid);
+	printf("MediaPlayer: streaming %s through ARM helper\n", source_spec);
+	return 1;
+}
+
+static int send_control(uint8_t command)
+{
+	ssize_t count;
+
+	if (control_fd < 0) return 0;
+	do count = write(control_fd, &command, sizeof(command));
+	while (count < 0 && errno == EINTR);
+	if (count == 1) return 1;
+	diagnostic_write("control write command=%u count=%d errno=%d message=%s\n",
+	                 command, (int)count, count < 0 ? errno : 0,
+	                 count < 0 ? strerror(errno) : "short write");
+	return 0;
+}
+
+static int discard_helper_output(uint64_t *discarded)
+{
+	uint8_t scratch[16384];
+
+	*discarded += pending_size - pending_offset;
+	pending_size = pending_offset = 0;
+	pending_eof = false;
+	for (;;)
+	{
+		ssize_t count = read(helper_fd, scratch, sizeof(scratch));
+		if (count > 0) { *discarded += (uint64_t)count; continue; }
+		if (!count) return 0;
+		if (errno == EINTR) continue;
+		if (errno == EAGAIN || errno == EWOULDBLOCK) return 1;
+		diagnostic_write("chapter discard failed errno=%d message=%s\n",
+		                 errno, strerror(errno));
+		return 0;
+	}
+}
+
+static int handle_control_event(uint8_t event)
+{
+	if (event == MEDIA_CONTROL_MENU_ENTER || event == MEDIA_CONTROL_MENU_LEAVE)
+	{
+		menu_active = event == MEDIA_CONTROL_MENU_ENTER;
+		diagnostic_write("DVD menu %s\n", menu_active ? "entered" : "left");
+		return 1;
+	}
+	if (event == MEDIA_CONTROL_ERROR)
+	{
+		diagnostic_write("helper control error\n");
+		stop_with_reason("control-error");
+		return 0;
+	}
+	return 1;
+}
+
+static void control_event_poll()
+{
+	if (control_fd < 0) return;
+	for (;;)
+	{
+		uint8_t event = 0;
+		ssize_t count = read(control_fd, &event, sizeof(event));
+		if (count == 1)
+		{
+			if (!handle_control_event(event)) return;
+			if (event != MEDIA_CONTROL_MENU_ENTER &&
+			    event != MEDIA_CONTROL_MENU_LEAVE)
+				diagnostic_write("unexpected control event=0x%02x\n", event);
+			continue;
+		}
+		if (count < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)
+		{
+			diagnostic_write("control read failed errno=%d message=%s\n", errno, strerror(errno));
+			stop_with_reason("control-read-error");
+		}
+		return;
+	}
+}
+
+static void chapter_barrier_poll()
+{
+	uint8_t event = 0;
+	ssize_t count;
+	uint64_t discarded = 0;
+
+	if ((!chapter_barrier && !navigation_pending) ||
+	    control_fd < 0 || helper_fd < 0) return;
+	count = read(control_fd, &event, sizeof(event));
+	if (count < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)
+	{
+		diagnostic_write("control read failed errno=%d message=%s\n", errno, strerror(errno));
+		stop_with_reason("control-read-error");
+		return;
+	}
+	if (navigation_pending && count == 1)
+	{
+		if (event == MEDIA_CONTROL_MENU_CONTINUE)
+		{
+			navigation_pending = false;
+			diagnostic_write("DVD menu continuation preserved resident frame\n");
+			return;
+		}
+		if (event == MEDIA_CONTROL_READY)
+		{
+			navigation_pending = false;
+			chapter_barrier = true;
+			chapter_download_rearmed = false;
+			if (download_active)
+			{
+				user_io_set_download(0);
+				download_active = 0;
+			}
+			pending_size = pending_offset = 0;
+			pending_eof = false;
+			diagnostic_write("DVD navigation stream hop ready\n");
+		}
+		else
+		{
+			if (!handle_control_event(event)) return;
+			return;
+		}
+	}
+	if (navigation_pending) return;
+	if (count == 1 && event != MEDIA_CONTROL_READY)
+	{
+		if (!handle_control_event(event)) return;
+		event = 0;
+	}
+	if (!discard_helper_output(&discarded))
+	{
+		stop_with_reason("chapter-helper-eof");
+		return;
+	}
+	if (count != 1 || event != MEDIA_CONTROL_READY)
+	{
+		if (discarded)
+			diagnostic_write("chapter discard bytes=%llu waiting=1\n",
+			                 (unsigned long long)discarded);
+		return;
+	}
+	burst_state = {};
+	if (!chapter_download_rearmed)
+	{
+		user_io_set_index(playback_index);
+		user_io_file_info(".M2V");
+		user_io_set_download(1);
+		download_active = 1;
+		download_assert_us = monotonic_us();
+	}
+	if (!send_control(MEDIA_CONTROL_GO))
+	{
+		stop_with_reason("chapter-go-error");
+		return;
+	}
+	chapter_barrier = false;
+	chapter_download_rearmed = false;
+	diagnostic_write("chapter barrier released discarded=%llu paused=%d\n",
+	                 (unsigned long long)discarded, playback_paused);
+}
+
+int mediaplayer_input(unsigned input, int pressed, int osd_visible)
+{
+	if (helper_fd < 0 || osd_visible || !mediaplayer_is_core()) return 0;
+	if (input >= MEDIAPLAYER_INPUT_MENU_UP &&
+	    input <= MEDIAPLAYER_INPUT_MENU_ACTIVATE &&
+	    (!menu_controls || !menu_active)) return 0;
+	if (input == MEDIAPLAYER_INPUT_ROOT_MENU && !menu_controls) return 0;
+	if (input >= MEDIAPLAYER_INPUT_SEEK_BACK_10 &&
+	    input <= MEDIAPLAYER_INPUT_SEEK_FORWARD_300 && !seek_controls) return 0;
+	if (!pressed) return 1;
+
+	if (input == MEDIAPLAYER_INPUT_PLAY_PAUSE && menu_active)
+		input = MEDIAPLAYER_INPUT_MENU_ACTIVATE;
+
+	if (input == MEDIAPLAYER_INPUT_PLAY_PAUSE)
+	{
+		if (chapter_barrier || navigation_pending) return 1;
+		playback_paused = !playback_paused;
+		diagnostic_write("playback %s submitted=%llu\n",
+		                 playback_paused ? "paused" : "resumed",
+		                 (unsigned long long)submitted_bytes);
+		printf("MediaPlayer: %s\n", playback_paused ? "paused" : "resumed");
+		return 1;
+	}
+	if (input >= MEDIAPLAYER_INPUT_MENU_UP &&
+	    input <= MEDIAPLAYER_INPUT_ROOT_MENU)
+	{
+		if (!menu_controls) return 0;
+		if (input != MEDIAPLAYER_INPUT_ROOT_MENU && !menu_active) return 0;
+		uint8_t command = input == MEDIAPLAYER_INPUT_MENU_UP ? MEDIA_CONTROL_MENU_UP :
+		                  input == MEDIAPLAYER_INPUT_MENU_DOWN ? MEDIA_CONTROL_MENU_DOWN :
+		                  input == MEDIAPLAYER_INPUT_MENU_LEFT ? MEDIA_CONTROL_MENU_LEFT :
+		                  input == MEDIAPLAYER_INPUT_MENU_RIGHT ? MEDIA_CONTROL_MENU_RIGHT :
+		                  input == MEDIAPLAYER_INPUT_MENU_ACTIVATE ? MEDIA_CONTROL_MENU_ACTIVATE :
+		                  MEDIA_CONTROL_ROOT_MENU;
+		if (chapter_barrier || navigation_pending || playback_paused) return 1;
+		if (command != MEDIA_CONTROL_MENU_ACTIVATE && command != MEDIA_CONTROL_ROOT_MENU)
+		{
+			if (!send_control(command)) stop_with_reason("menu-command-error");
+			return 1;
+		}
+		navigation_pending = true;
+		if (!send_control(command)) stop_with_reason("menu-command-error");
+		diagnostic_write("DVD navigation command=0x%02x submitted=%llu\n",
+		                 command, (unsigned long long)submitted_bytes);
+		return 1;
+	}
+	if (input >= MEDIAPLAYER_INPUT_SEEK_BACK_10 &&
+	    input <= MEDIAPLAYER_INPUT_SEEK_FORWARD_300)
+	{
+		if (chapter_barrier || navigation_pending || playback_paused) return 1;
+		uint8_t command =
+			input == MEDIAPLAYER_INPUT_SEEK_BACK_10 ? MEDIA_CONTROL_SEEK_BACK_10 :
+			input == MEDIAPLAYER_INPUT_SEEK_FORWARD_10 ? MEDIA_CONTROL_SEEK_FORWARD_10 :
+			input == MEDIAPLAYER_INPUT_SEEK_BACK_60 ? MEDIA_CONTROL_SEEK_BACK_60 :
+			input == MEDIAPLAYER_INPUT_SEEK_FORWARD_60 ? MEDIA_CONTROL_SEEK_FORWARD_60 :
+			input == MEDIAPLAYER_INPUT_SEEK_BACK_300 ? MEDIA_CONTROL_SEEK_BACK_300 :
+			MEDIA_CONTROL_SEEK_FORWARD_300;
+		int seconds =
+			input == MEDIAPLAYER_INPUT_SEEK_BACK_10 ? -10 :
+			input == MEDIAPLAYER_INPUT_SEEK_FORWARD_10 ? 10 :
+			input == MEDIAPLAYER_INPUT_SEEK_BACK_60 ? -60 :
+			input == MEDIAPLAYER_INPUT_SEEK_FORWARD_60 ? 60 :
+			input == MEDIAPLAYER_INPUT_SEEK_BACK_300 ? -300 : 300;
+		if (download_active)
+		{
+			user_io_set_download(0);
+			download_active = 0;
+		}
+		pending_size = pending_offset = 0;
+		pending_eof = false;
+		burst_state = {};
+		user_io_set_index(playback_index);
+		user_io_file_info(".M2V");
+		user_io_set_download(1);
+		download_active = 1;
+		download_assert_us = monotonic_us();
+		chapter_download_rearmed = true;
+		chapter_barrier = true;
+		if (!send_control(command))
+		{
+			stop_with_reason("seek-command-error");
+			return 1;
+		}
+		diagnostic_write("seek command=%+d seconds submitted=%llu\n",
+		                 seconds, (unsigned long long)submitted_bytes);
+		printf("MediaPlayer: seek %+d seconds\n", seconds);
+		return 1;
+	}
+
+	if (input != MEDIAPLAYER_INPUT_PREVIOUS &&
+	    input != MEDIAPLAYER_INPUT_NEXT)
+		return 0;
+	if (chapter_barrier || navigation_pending || playback_paused ||
+	    !chapter_controls) return 1;
+
+	uint8_t command = input == MEDIAPLAYER_INPUT_PREVIOUS ?
+	                  MEDIA_CONTROL_PREVIOUS_CHAPTER :
+	                  MEDIA_CONTROL_NEXT_CHAPTER;
+	if (download_active)
+	{
+		user_io_set_download(0);
+		download_active = 0;
+	}
+	pending_size = pending_offset = 0;
+	pending_eof = false;
+	burst_state = {};
+	user_io_set_index(playback_index);
+	user_io_file_info(".M2V");
+	user_io_set_download(1);
+	download_active = 1;
+	download_assert_us = monotonic_us();
+	chapter_download_rearmed = true;
+	diagnostic_write("chapter startup blank rearmed command=%s\n",
+	                 command == MEDIA_CONTROL_PREVIOUS_CHAPTER ?
+	                     "previous" : "next");
+	chapter_barrier = true;
+	if (!send_control(command))
+	{
+		stop_with_reason("chapter-command-error");
+		return 1;
+	}
+	diagnostic_write("chapter command=%s submitted=%llu\n",
+	                 command == MEDIA_CONTROL_PREVIOUS_CHAPTER ? "previous" : "next",
+	                 (unsigned long long)submitted_bytes);
+	printf("MediaPlayer: %s chapter\n",
+	       command == MEDIA_CONTROL_PREVIOUS_CHAPTER ? "previous" : "next");
+	return 1;
+}
+
+void mediaplayer_joystick(unsigned char joystick, uint32_t map, int osd_visible)
+{
+	static uint32_t previous_map = 0;
+	uint32_t pressed;
+
+	if (joystick != 0) return;
+	pressed = map & ~previous_map;
+	previous_map = map;
+	if (pressed & JOY_SELECT)
+		mediaplayer_input(MEDIAPLAYER_INPUT_ROOT_MENU, 1, osd_visible);
+	else if (menu_active && (pressed & JOY_A))
+		mediaplayer_input(MEDIAPLAYER_INPUT_MENU_ACTIVATE, 1, osd_visible);
+	else if (menu_active && (pressed & JOY_UP))
+		mediaplayer_input(MEDIAPLAYER_INPUT_MENU_UP, 1, osd_visible);
+	else if (menu_active && (pressed & JOY_DOWN))
+		mediaplayer_input(MEDIAPLAYER_INPUT_MENU_DOWN, 1, osd_visible);
+	else if (menu_active && (pressed & JOY_LEFT))
+		mediaplayer_input(MEDIAPLAYER_INPUT_MENU_LEFT, 1, osd_visible);
+	else if (menu_active && (pressed & JOY_RIGHT))
+		mediaplayer_input(MEDIAPLAYER_INPUT_MENU_RIGHT, 1, osd_visible);
+	else if (pressed & JOY_LEFT)
+		mediaplayer_input(MEDIAPLAYER_INPUT_PREVIOUS, 1, osd_visible);
+	else if (pressed & JOY_RIGHT)
+		mediaplayer_input(MEDIAPLAYER_INPUT_NEXT, 1, osd_visible);
+}
+
+static void mediaplayer_poll_inner()
+{
+	if (helper_fd < 0) return;
+	if (!mediaplayer_is_core()) { stop_with_reason("core-changed"); return; }
+	const uint64_t poll_start = monotonic_us();
+	bool read_this_poll = false;
+	for (unsigned step = 0; step < media_poll_step_limit; ++step)
+	{
+		if (step && monotonic_us() - poll_start >= media_poll_budget_us) return;
+		// A lone byte waits for its partner (or EOF); never pad a short pipe
+		// read in the middle of the byte stream. No second pipe read per poll.
+		if (pending_size - pending_offset < 2 && !pending_eof)
+		{
+			if (read_this_poll) return;
+			read_this_poll = true;
+			const uint32_t remaining = pending_size - pending_offset;
+			if (remaining) pending_buffer[0] = pending_buffer[pending_offset];
+			pending_size = remaining; pending_offset = 0;
+			const uint64_t read_start = monotonic_us();
+			const ssize_t count = read(helper_fd, pending_buffer + remaining,
+			                           sizeof(pending_buffer) - remaining);
+			const int read_errno = count < 0 ? errno : 0;
+			const uint64_t read_elapsed = monotonic_us() - read_start;
+			if (diagnostic_fd >= 0) { ++transfer_profile.read_calls; transfer_profile.read_us += read_elapsed; }
+			if (count > 0)
+			{
+				pending_size += (uint32_t)count; ++read_events;
+				diagnostic_write("pipe_read event=%u count=%d read_us=%llu buffered=%u\n",
+				                 read_events, (int)count, (unsigned long long)read_elapsed, pending_size);
+			}
+			else if (!count) { pending_eof = true; diagnostic_write("helper stdout eof\n"); }
+			else if (read_errno == EAGAIN || read_errno == EWOULDBLOCK || read_errno == EINTR)
+			{
+				++would_block_events;
+				if (would_block_events <= 4 || !(would_block_events & (would_block_events - 1)))
+					diagnostic_write("would_block count=%u submitted=%llu\n", would_block_events, (unsigned long long)submitted_bytes);
+				return;
+			}
+			else
+			{
+				diagnostic_write("read failed errno=%d message=%s\n", read_errno, strerror(read_errno));
+				stop_with_reason("read-error"); return;
+			}
+		}
+		if (pending_eof && pending_size == pending_offset)
+		{
+			finish_download("eof");
+			if (helper_pid > 0)
+			{
+				int status = 0;
+				pid_t result = waitpid(helper_pid, &status, 0);
+				int wait_errno = result < 0 ? errno : 0;
+				diagnostic_write("child wait=%d status=0x%x wait_errno=%d exited=%d exit_code=%d signaled=%d signal=%d\n",
+				                 (int)result, status, wait_errno,
+				                 WIFEXITED(status),
+				                 WIFEXITED(status) ? WEXITSTATUS(status) : -1,
+				                 WIFSIGNALED(status),
+				                 WIFSIGNALED(status) ? WTERMSIG(status) : 0);
+				if (result == helper_pid &&
+				    (!WIFEXITED(status) || WEXITSTATUS(status)))
+					printf("MediaPlayer: ARM helper exited with an error\n");
+				helper_pid = -1;
+			}
+			diagnostic_write("transfer complete submitted=%llu reads=%u\n",
+			                 (unsigned long long)submitted_bytes, read_events);
+			diagnostic_close();
+			printf("MediaPlayer: stream transfer finished\n");
+			return;
+		}
+		uint32_t available = pending_size - pending_offset;
+		if (!pending_eof) available &= ~1u;
+		if (!available) return;
+		const bool sampled = diagnostic_fd >= 0 && !((transfer_events + 1) % 64);
+		fpga_spi_profile ack = {};
+		media_burst_stats burst = {};
+		uint32_t consumed = 0;
+		const uint64_t tx_start = monotonic_us();
+		const int valid = user_io_file_tx_data_step(pending_buffer + pending_offset,
+		    available, &burst_state, &burst, &consumed, sampled ? &ack : NULL);
+		const uint64_t tx_elapsed = monotonic_us() - tx_start;
+		if (diagnostic_fd >= 0)
+		{
+			transfer_profile.tx_us += tx_elapsed;
+			if (tx_elapsed > transfer_profile.tx_max_us) transfer_profile.tx_max_us = tx_elapsed;
+			transfer_profile.fast_bytes += burst.fast_bytes;
+			transfer_profile.slow_bytes += burst.slow_bytes;
+			transfer_profile.burst_calls += burst.batches;
+			transfer_profile.status_queries += burst.queries;
+			if (consumed) { ++transfer_profile.tx_calls; transfer_profile.ack_chunks += sampled; }
+		}
+		if (!valid || consumed > available)
+		{
+			diagnostic_write("transport_fault error=%u mode=%u verified_prior_bytes=%llu expected_words=%u observed_words=%u expected_digest=%04x observed_digest=%04x credit=%u flags=%u\n",
+			    burst.error, burst_state.mode, (unsigned long long)submitted_bytes,
+			    burst.expected_words, burst.observed_words, burst.expected_digest, burst.observed_digest, burst.credit, burst.flags);
+			stop_with_reason("transport-fault"); return;
+		}
+		if (!consumed) return; // No credits: leave the exact pending bytes for next poll.
+		pending_offset += consumed; submitted_bytes += consumed; ++transfer_events;
+		if (!first_byte_seen)
+		{
+			first_byte_seen = 1;
+			diagnostic_write("first_byte latency_us=%llu would_block=%u count=%u\n",
+			    (unsigned long long)(monotonic_us() - download_assert_us), would_block_events, consumed);
+		}
+		if (transfer_events <= 4 || sampled)
+			diagnostic_write("transfer event=%u count=%u submitted=%llu tx_us=%llu fast_bytes=%u slow_bytes=%u queries=%u\n",
+			    transfer_events, consumed, (unsigned long long)submitted_bytes,
+			    (unsigned long long)tx_elapsed, burst.fast_bytes, burst.slow_bytes, burst.queries);
+	}
+}
+
+void mediaplayer_poll()
+{
+	if (helper_fd < 0) return;
+	if (chapter_barrier || navigation_pending)
+	{
+		chapter_barrier_poll();
+		if (helper_fd < 0 || chapter_barrier) return;
+	}
+	if (!navigation_pending) control_event_poll();
+	if (helper_fd < 0) return;
+	if (playback_paused) return;
+	if (diagnostic_fd >= 0)
+	{
+		media_transfer_profile &p = transfer_profile;
+		p.poll_start = monotonic_us();
+		p.poll_interval = p.polls ? p.poll_start - p.last_poll_start : 0;
+		if (p.polls)
+		{
+			++p.intervals;
+			p.interval_us += p.poll_interval;
+			if (p.poll_interval > p.interval_max_us) p.interval_max_us = p.poll_interval;
+		}
+		p.last_poll_start = p.poll_start;
+		p.poll_tx_start = p.tx_calls;
+		p.poll_active = true;
+	}
+	mediaplayer_poll_inner();
+	profile_poll_finish();
+}
